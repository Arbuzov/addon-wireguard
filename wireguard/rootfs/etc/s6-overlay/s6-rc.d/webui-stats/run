#!/command/with-contenv bashio
# shellcheck shell=bash
# Publish a small read-only snapshot for the existing Ingress web root.
if ! bashio::config.true 'web_interface'; then
    exec sleep infinity
fi

interface="wg0"
if bashio::config.has_value 'server.interface'; then
    interface=$(bashio::config 'server.interface')
fi

state_dir="/var/lib/wireguard"
stats_file="${state_dir}/www/stats.json"
umask 077

publish_stats() {
    local transfers handshakes collected_at key rx tx handshake hash name tmp
    local -A last_handshake=()

    # Select only the configured interface and fields that never include secrets.
    transfers=$(wg show "${interface}" transfer) || return 1
    handshakes=$(wg show "${interface}" latest-handshakes) || return 1
    collected_at=$(date +%s) || return 1

    while IFS=$'\t' read -r key handshake; do
        if [[ "${key}" =~ ^[A-Za-z0-9+/]{43}=$ && "${handshake}" =~ ^[0-9]+$ ]]; then
            last_handshake["${key}"]="${handshake}"
        fi
    done <<< "${handshakes}"

    # Create the temporary file outside the served tree, then publish atomically.
    tmp=$(mktemp "${state_dir}/.webui-stats.XXXXXX") || return 1
    if {
        while IFS=$'\t' read -r key rx tx; do
            if ! [[ "${key}" =~ ^[A-Za-z0-9+/]{43}=$ && "${rx}" =~ ^[0-9]+$ && "${tx}" =~ ^[0-9]+$ ]]; then
                continue
            fi
            # The two reads can disagree if peers change; skip incomplete rows.
            handshake="${last_handshake[${key}]:-}"
            [[ -n "${handshake}" ]] || continue
            hash=$(sha1sum <<< "${key}") || continue
            hash="${hash%% *}"
            [[ -f "${state_dir}/${hash}" ]] || continue
            name=$(<"${state_dir}/${hash}")
            [[ "${name}" =~ ^[a-zA-Z0-9][a-zA-Z0-9-]{0,32}$ ]] || continue
            printf '%s\t%s\t%s\t%s\n' "${name}" "${handshake}" "${rx}" "${tx}"
        done <<< "${transfers}"
    } | jq -Rn --argjson collected_at "${collected_at}" '
        {collected_at: $collected_at, peers: (reduce inputs as $line ({};
            ($line | split("\t")) as [$name, $handshake, $rx, $tx] |
            .[$name] = {
                latest_handshake: ($handshake | tonumber),
                transfer_rx: ($rx | tonumber),
                transfer_tx: ($tx | tonumber)
            }
        ))}
    ' > "${tmp}" && mv -f "${tmp}" "${stats_file}"; then
        return 0
    fi
    rm -f "${tmp}"
    return 1
}

while true; do
    # Do not present an old snapshot as live after a failed read.
    publish_stats || rm -f "${stats_file}"
    sleep 10
done
